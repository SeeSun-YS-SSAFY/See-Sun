# API 모킹 설정 (enabled: MSW 사용, disabled: 실제 API 사용)
NEXT_PUBLIC_API_MOCKING=disabled

# Backend API 엔드포인트
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MEDIA_URL=http://localhost:8000

# Google OAuth 설정 (Backend의 GOOGLE_CLIENT_ID와 동일해야 함)
NEXT_PUBLIC_API_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback