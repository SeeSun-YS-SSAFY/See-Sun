# =============================================================================
# See:Sun 운영 환경변수 — deploy/.env 로 복사해 값을 채운다(이 예시 파일만 커밋, .env는 커밋 금지)
#   cp .env.example .env && chmod 600 .env
# 비밀값 생성 명령은 각 항목 주석 참고. 비어 있는 필수 항목이 있으면 컨테이너가 시작되지 않는다.
# =============================================================================

# ---- 도메인·HTTPS(Caddy) -------------------------------------------------------
# API 도메인(DNS A 레코드가 이 VM 고정 IP를 가리켜야 인증서 발급됨). 예: api.seesun.example
API_DOMAIN=
# Let's Encrypt 인증서 만료 알림 받을 이메일(enVision 공용 계정 권장)
ACME_EMAIL=

# ---- 이미지 -------------------------------------------------------------------
# 사용할 백엔드 이미지(GHCR 등). 비우면 이 VM에서 ../backend 를 빌드한 seesun-backend:latest
DJANGO_IMAGE=
# 1이면 컨테이너 시작 시 migrate(기준 데이터 적재 포함) 실행
RUN_MIGRATIONS=1

# ---- Django 기본 --------------------------------------------------------------
# 운영은 반드시 false
DJANGO_DEBUG=false
# 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 필수. 쉼표 구분. 보통 API_DOMAIN과 같은 값
DJANGO_ALLOWED_HOSTS=
# 관리자 화면(/admin) 로그인용. 예: https://api.seesun.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS 리다이렉트(Caddy가 X-Forwarded-Proto를 넘김). 기본 true
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS(초). 기본 1년. 처음 배포 때 문제가 걱정되면 3600으로 시작 후 늘린다
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# HSTS preload 목록 등록 의사가 있을 때만 true(도메인 소유자 결정)
# DJANGO_HSTS_PRELOAD=false
# 로그 수준(INFO 권장). 개인정보는 로그에 남기지 않으며 스크러빙 필터가 한 번 더 가린다
LOG_LEVEL=INFO
# Android 앱은 CORS 대상이 아니다. 웹 관리 도구가 생기면 그 주소만 쉼표로
CORS_ALLOWED_ORIGINS=

# ---- PostgreSQL(같은 VM의 컨테이너) ---------------------------------------------
POSTGRES_DB=seesun
POSTGRES_USER=seesun
# 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# 관리형 DB(Lightsail Managed PostgreSQL 등)로 옮길 때만 사용: 호스트·SSL
# POSTGRES_HOST=ls-xxxx.ap-northeast-2.rds.amazonaws.com
# POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# ---- 필드 암호화(전화번호·건강정보) — 분실하면 데이터 복구 불가, 백업과 다른 곳에 보관 -------------
# 필수. Fernet 키(쉼표로 여러 개: 첫 키로 암호화, 전부로 복호화). 교체 절차는 README §7
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# 필수. 전화번호 해시(조회 색인) 키. 바꾸면 manage.py rotate_field_keys 로 재계산
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_KEY=

# ---- Firebase 전화번호 인증 -------------------------------------------------------
# 서비스 계정 JSON을 deploy/secrets/ 에 두고 컨테이너 경로로 지정(권장: 토큰 폐기 확인·탈퇴 시 Firebase 사용자 삭제 가능)
FIREBASE_CREDENTIALS_FILE=/run/secrets/seesun/firebase-service-account.json
# 또는 프로젝트 ID만(서명 검증은 되지만 폐기 확인·사용자 삭제는 안 됨)
FIREBASE_PROJECT_ID=
# 폐기된 토큰 거부(서비스 계정 있을 때만 동작)
FIREBASE_CHECK_REVOKED=true
# 운영에서는 절대 켜지 않는다(DEBUG=false면 기동 실패)
FIREBASE_AUTH_FAKE=false

# ---- 미디어 CDN(Cloudflare R2 공개 버킷 + 커스텀 도메인) ------------------------------
# 픽토그램·운동 음성 주소의 앞부분. 예: https://media.seesun.example (끝 슬래시 없이)
MEDIA_CDN_BASE_URL=

# ---- 요청 제한 ---------------------------------------------------------------
THROTTLE_FIREBASE=10/min
THROTTLE_SEARCH=60/min
THROTTLE_SYNC=60/min
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_STT=30/min
# 오프라인 큐 일괄 업로드 1회 최대 건수
BULK_MAX_ITEMS=50
# gunicorn 워커가 여러 개라 요청 제한 카운터를 공유하려면 Redis(선택). 비우면 워커별 메모리
REDIS_URL=

# ---- gunicorn -----------------------------------------------------------------
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=30

# ---- 가입 정책·1차 호환 -----------------------------------------------------------
# 만 14세 미만 가입 차단(05 문서 L-04)
MIN_SIGNUP_AGE=14
# 1차 웹 데모 기능. 2차 운영에서는 false 유지
PIN_LOGIN_ENABLED=false
LEGACY_STT_ENABLED=false

# ---- 산식 기준표 교체(선택) ------------------------------------------------------
# 의뢰인 기준 문서 수령 후 새 기준표 모듈을 만들면 지정. 예: seesun_rules.tables_v2
# SEESUN_RULES_TABLES=seesun_rules.tables_v1

# ---- 백업(deploy/backup.sh, VM의 cron에서 실행) ------------------------------------
# 로컬 보관 일수
BACKUP_RETENTION_DAYS=14
# R2 업로드(선택): 비공개 버킷 이름·엔드포인트. aws CLI가 VM에 설치돼 있어야 함
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
# R2 API 토큰(Object Read & Write, 백업 버킷만). aws CLI가 읽는 이름
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 백업 파일 암호화(선택, 권장): gpg 공개키 수신자(이메일·키 ID). 개인키는 VM 밖에 보관
BACKUP_GPG_RECIPIENT=
# 백업 성공 알림(선택): Healthchecks.io 핑 URL
BACKUP_HEALTHCHECK_URL=

# ---- 1차 Google 연동(선택, 2차 Android는 사용 안 함) ---------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/seesun/google-credentials.json
