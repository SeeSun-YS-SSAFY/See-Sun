# 가운영 작업 PC 설정(예시). 복사해 저장소 밖(예: deploy_prov/prov.env)에 두고 실제 값을 넣는다 — 커밋 금지.
# 쓰는 곳: build_android_release.sh, publish_apk.sh (SEESUN_PROV_ENV=<이 파일 경로> 로 넘긴다)
# 서버 쪽 값(API_DOMAIN·ACME_EMAIL·ADMIN_ALLOWED_IPS 등)은 서버의 .env(env.template)에 따로 둔다.

# 공개 API 도메인(Caddy가 인증서를 받는 이름). 앱 API 주소는 https://<API_DOMAIN>/api/v1/
API_DOMAIN=<API_DOMAIN>
# 앱 release 서명 설정 파일(storeFile·storePassword·keyAlias·keyPassword)
SEESUN_SIGNING_PROPERTIES=<저장소 밖 경로>/keys/signing.properties
# 서버 SSH(앱 업데이트 게시용)
SEESUN_PROV_HOST=<SERVER_IP>
SEESUN_PROV_SSH_USER=ubuntu
SEESUN_PROV_SSH_KEY=<저장소 밖 경로>/keys/<ssh 개인 키>
# 서버의 번들 폴더
SEESUN_PROV_DIR=/home/ubuntu/seesun-prov
