# =============================================================================
# 시선(See:Sun) 가운영 환경변수 — deploy.sh가 이 파일을 .env 로 복사한다(chmod 600)
#   - 「<...>」 자리표시 4개만 사람이 채운다. 남아 있으면 deploy.sh가 멈춘다.
#   - 비밀값(빈 칸으로 둔 SECRET·PASSWORD·KEYS)은 서버에서 deploy.sh가 처음 한 번 무작위로 만든다.
#     이 파일(템플릿)에는 비밀값을 절대 적지 않는다.
#   - 전체 항목 설명은 저장소 deploy/.env.example
# =============================================================================

# ---- 사람이 채우는 값 -------------------------------------------------------------
# DuckDNS에서 만든 하위 도메인(이 서버의 고정 IP를 가리켜야 HTTPS 인증서가 발급된다)
API_DOMAIN=<sub>.duckdns.org
# Let's Encrypt 인증서 만료 알림 이메일
ACME_EMAIL=<인증서 알림 받을 이메일>
# Firebase 콘솔 → 프로젝트 설정 → 프로젝트 ID(전화번호 인증 토큰의 서명 검증에 쓴다)
FIREBASE_PROJECT_ID=<firebase-project-id>
# /admin/ 을 열어 줄 IP(공백 구분). SSH 터널로만 쓸 거면 「private_ranges」만 남긴다.
# 예: ADMIN_ALLOWED_IPS=private_ranges 203.0.113.10/32
ADMIN_ALLOWED_IPS=private_ranges <관리자 PC 공인 IP>/32
# 운영 콘솔(/ops/) 허용 IP. any = 어느 IP에서나(비밀번호 + 2단계 인증으로 보호, 2026-10-15 소유자 결정).
# 비우면 ADMIN_ALLOWED_IPS와 같은 목록으로 제한한다. /admin/ 은 이 값과 관계없이 ADMIN_ALLOWED_IPS에서만 열린다.
OPS_ALLOWED_IPS=any

# ---- deploy.sh가 서버에서 만드는 비밀값(비워 둔다) -----------------------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# 분실하면 전화번호·건강정보를 영영 복호화할 수 없다. 만든 뒤 서버 밖 안전한 곳(비밀번호 관리자)에 따로 보관
FIELD_ENCRYPTION_KEYS=
PHONE_HASH_KEY=
# 비우면 deploy.sh가 API_DOMAIN으로 채운다
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- 고정값(가운영) ---------------------------------------------------------------
DJANGO_IMAGE=seesun-backend:prov-20261015
RUN_MIGRATIONS=1
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
# Caddy도 같은 HSTS(1년)를 붙인다. check --deploy 경고 0을 위해 운영과 같은 값
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=seesun
POSTGRES_USER=seesun
POSTGRES_CONN_MAX_AGE=60

# Firebase 서비스 계정 JSON(선택). 넣으면 탈퇴 때 Firebase 사용자 삭제·토큰 폐기 확인까지 된다.
#   secrets/firebase-service-account.json 에 두고 아래 줄의 주석을 푼다. 없으면 프로젝트 ID만으로 서명 검증.
# FIREBASE_CREDENTIALS_FILE=/run/secrets/seesun/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CHECK_REVOKED=true
# 운영에서는 절대 켜지 않는다(DEBUG=false면 기동 실패)
FIREBASE_AUTH_FAKE=false

# 비우면 /media/... 를 Caddy가 media 볼륨에서 직접 서빙(가운영 기본)
MEDIA_CDN_BASE_URL=

THROTTLE_FIREBASE=10/min
THROTTLE_SEARCH=60/min
THROTTLE_SYNC=60/min
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
BULK_MAX_ITEMS=50
REDIS_URL=

# 2GB VM: sync 워커 3개(스레드 1 유지 — 배포 리허설 B-13)
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=30

MIN_SIGNUP_AGE=14
PIN_LOGIN_ENABLED=false
LEGACY_STT_ENABLED=false

# 백업(backup.sh, deploy.sh가 매일 03:15 KST cron 등록). 가운영은 서버 안에만 7일 보관
BACKUP_RETENTION_DAYS=7
BACKUP_BUCKET=
BACKUP_REGION=ap-northeast-2
BACKUP_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_GPG_RECIPIENT=
BACKUP_HEALTHCHECK_URL=
