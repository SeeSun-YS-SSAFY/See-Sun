# ---- Django ----
# 로컬 개발만 true. 운영은 false(기본값)
DJANGO_DEBUG=true
# 운영은 반드시 새로 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# 운영 예: https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# 운영 예: https://app.example.com (DEBUG=false면 전체 허용이 꺼짐)
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# ---- 요청 제한·로그인 잠금 ----
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_STT=30/min
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# 여러 프로세스에서 잠금·제한을 공유하려면 설정
REDIS_URL=

# Google OAuth 설정 (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Cloud 서비스 계정 인증 파일 경로 (파일은 커밋 금지)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Gemini API 키 (유료 등급만 사용. 무료 등급은 입력 데이터가 학습에 쓰일 수 있음)
GEMINI_API_KEY=your-gemini-api-key
