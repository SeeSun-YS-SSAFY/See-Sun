# 로컬 개발용 환경변수(backend/.env 로 복사). 운영 값 설명은 deploy/.env.example 참고

# ---- Django ----
# 로컬 개발만 true. 운영은 false(기본값)
DJANGO_DEBUG=true
# 비워 두면 DEBUG에서만 개발용 키 사용. 운영은 반드시 새로 생성
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# ---- DB(docker-compose의 db 서비스) ----
POSTGRES_DB=seesun
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# ---- 필드 암호화(비우면 DEBUG에서만 SECRET_KEY 파생 키 사용 — check --deploy가 오류로 알림) ----
FIELD_ENCRYPTION_KEYS=
PHONE_HASH_KEY=

# ---- Firebase ----
# 로컬은 가짜 검증기(id_token = "fake:<uid>:+8210xxxxxxxx"). DEBUG=true에서만 켜진다
FIREBASE_AUTH_FAKE=true
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=

# ---- 미디어 CDN(비우면 /media/ 상대 경로) ----
MEDIA_CDN_BASE_URL=

# ---- 1차 웹 데모 호환(2차 Android 흐름에서는 끔) ----
PIN_LOGIN_ENABLED=true
LEGACY_STT_ENABLED=true
# 서버 STT·운동 안내 TTS용 Google Cloud 서비스 계정 파일(커밋 금지)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 요청 제한·로그인 잠금 ----
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_FIREBASE=10/min
THROTTLE_SEARCH=60/min
THROTTLE_SYNC=60/min
THROTTLE_STT=30/min
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
REDIS_URL=
