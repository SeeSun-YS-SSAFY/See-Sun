    <!-- A-04 내 개인정보 권리 -->
    <string name="my_rights_intro">개인정보에 대한 권리는 앱 안에서 버튼이나 음성으로, 또는 전화·문자·이메일로 언제든 행사할 수 있어요. 가입할 때보다 어렵지 않게 만들었어요.</string>
    <string name="my_rights_view">내 정보 보기(열람)</string>
    <string name="my_rights_view_desc">저장된 내 정보와 건강 정보를 읽어 드려요</string>
    <string name="my_rights_edit">내 정보 고치기(정정)</string>
    <string name="my_rights_edit_desc">이름 · 생년월일 · 성별 · 키 · 몸무게</string>
    <string name="my_rights_delete_part">일부 지우기(데이터 초기화)</string>
    <string name="my_rights_delete_part_desc">식사 기록 또는 건강 정보만</string>
    <string name="my_rights_stop">처리 멈추기·동의 철회</string>
    <string name="my_rights_stop_desc">건강정보 처리 동의 철회 등</string>
    <string name="my_rights_delete_all">모두 지우기(회원 탈퇴)</string>
    <string name="my_rights_delete_all_desc">계정과 모든 기록</string>
    <string name="my_rights_contact_title">전화·문자·이메일 문의</string>
    <string name="my_rights_contact">개인정보 보호책임자와 문의 연락처(전화·문자·이메일)는 운영자가 정하면 이 화면에 적어요. 요청을 받으면 10일 안에 처리 결과를 알려 드리는 것을 목표로 해요.</string>
    <string name="my_rights_voice_hint">내 정보 보기, 고치기, 지우기, 동의 철회, 탈퇴처럼 말씀해 주세요.</string>

    <!-- A-03 데이터 초기화 -->
    <string name="my_reset_intro">계정은 그대로 두고 일부 데이터만 지울 수 있어요. 지울 데이터를 골라 주세요.</string>
    <string name="my_reset_meals">식사 기록 모두 지우기</string>
    <string name="my_reset_meals_desc">식사 기록과 식단 점수</string>
    <string name="my_reset_health">건강 정보만 지우기</string>
    <string name="my_reset_health_desc">질환·알레르기·기타 알레르기</string>
    <string name="my_reset_meals_explain">식사 기록을 모두 지워요. 서버에 저장된 식사 기록과 식단 점수, 이 기기에 저장된 식사 기록이 지워지고 되돌릴 수 없어요. 아직 서버로 보내지 못한 기록 %1$d건도 함께 지워져요. 계정, 건강 정보, 목표, 동의 내용은 그대로 남아요.</string>
    <string name="my_reset_health_explain">건강 정보만 지워요. 질환, 알레르기, 기타 알레르기와 질환을 반영한 식단 점수가 지워지고 되돌릴 수 없어요. 계정, 식사 기록, 목표, 동의 내용은 그대로 남아요. 건강정보 처리 동의를 계속 두면 다시 입력할 수 있어요.</string>
    <string name="my_reset_backup">서버 백업 파일에는 최대 14일 동안 남아 있다가 자동으로 지워져요.</string>
    <string name="my_reset_continue">계속하기</string>
    <string name="my_reset_confirm_title">지우기 확인</string>
    <string name="my_reset_meals_question">정말 식사 기록을 모두 지울까요? 마지막 확인이에요.</string>
    <string name="my_reset_health_question">정말 건강 정보를 지울까요? 마지막 확인이에요.</string>
    <string name="my_reset_delete">지우기</string>
    <string name="my_reset_retry">다시 시도해서 지우기</string>
