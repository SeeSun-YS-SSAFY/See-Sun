root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = android_studio
# Compose 함수는 PascalCase, 테스트는 한국어 이름을 쓴다.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test, TestFactory, ParameterizedTest
ktlint_standard_function-naming = enabled

[*.{yml,yaml,json,toml}]
indent_size = 2
